
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// sample model user
model User{
  id Int @id 
  email String
  password String
  name String
}